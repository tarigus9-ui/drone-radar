<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:layoutDirection="rtl">

    <FrameLayout
        android:id="@+id/map_container"
        android:layout_width="match_parent" android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="top" android:layout_margin="12dp"
        android:background="#E6FFFFFF" android:elevation="4dp"
        android:orientation="vertical" android:padding="10dp">

        <TextView android:id="@+id/status"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/scanning" android:textColor="#111" android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <Button android:id="@+id/center" style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:minWidth="0dp" android:paddingHorizontal="2dp" android:textSize="13sp"
                android:text="@string/center" />
            <Button android:id="@+id/sat" style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:minWidth="0dp" android:paddingHorizontal="2dp" android:textSize="13sp"
                android:text="@string/map_plain" android:visibility="gone" />
            <Button android:id="@+id/history" style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:minWidth="0dp" android:paddingHorizontal="2dp" android:textSize="13sp"
                android:text="@string/history_short" android:visibility="gone" />
            <Button android:id="@+id/admin" style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:minWidth="0dp" android:paddingHorizontal="2dp" android:textSize="13sp"
                android:text="@string/admin_short" android:visibility="gone" />
            <Button android:id="@+id/toggle" style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:minWidth="0dp" android:paddingHorizontal="2dp" android:textSize="13sp"
                android:text="@string/stop" />
        </LinearLayout>

        <TextView android:id="@+id/list"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLines="6" android:textColor="#333" android:textSize="13sp" />

        <TextView android:id="@+id/account"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textColor="#1565C0" android:textSize="13sp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="@string/legend"
            android:textColor="#666" android:textSize="12sp" />
    </LinearLayout>

    <Button android:id="@+id/saw"
        android:layout_width="wrap_content" android:layout_height="64dp"
        android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="28dp"
        android:paddingHorizontal="28dp" android:elevation="8dp"
        android:background="#D32F2F" android:textColor="#FFFFFF" android:textSize="20sp"
        android:text="@string/saw_drone" android:visibility="gone" />
</FrameLayout>
